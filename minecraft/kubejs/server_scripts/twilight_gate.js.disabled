const GATE_TF_DIM = 'twilightforest:twilight_forest'
const GATE_OVERWORLD = 'minecraft:overworld'
const GATE_KEY_ITEM = 'minecraft:diamond'
const GATE_PORTAL = 'twilightforest:twilight_portal'
const GATE_RANGE = 10

const gateCooldown = {}
const gateInside = {}

function gateId(level, x, y, z) {
  return String(level.getBlock(x, y, z).id)
}

function gateIsPortal(level, x, y, z) {
  return gateId(level, x, y, z).indexOf('twilight_portal') >= 0
}

function gateScan(level, cx, cy, cz) {
  var hits = 0
  var yellow = false
  var blue = false
  var violet = false
  var pink = false
  var minX = 0
  var maxX = 0
  var minY = 0
  var maxY = 0
  var minZ = 0
  var maxZ = 0
  var first = true
  var dx = 0
  var dy = 0
  var dz = 0
  var id = ''

  for (dx = -GATE_RANGE; dx <= GATE_RANGE; dx++) {
    for (dz = -GATE_RANGE; dz <= GATE_RANGE; dz++) {
      for (dy = -2; dy <= 8; dy++) {
        id = gateId(level, cx + dx, cy + dy, cz + dz)
        if (id.indexOf('castle_rune_brick') >= 0) {
          hits = hits + 1
          if (id.indexOf('yellow_castle_rune_brick') >= 0) yellow = true
          if (id.indexOf('blue_castle_rune_brick') >= 0) blue = true
          if (id.indexOf('violet_castle_rune_brick') >= 0) violet = true
          if (id.indexOf('pink_castle_rune_brick') >= 0) pink = true
          if (first) {
            first = false
            minX = cx + dx
            maxX = cx + dx
            minY = cy + dy
            maxY = cy + dy
            minZ = cz + dz
            maxZ = cz + dz
          } else {
            if (cx + dx < minX) minX = cx + dx
            if (cx + dx > maxX) maxX = cx + dx
            if (cy + dy < minY) minY = cy + dy
            if (cy + dy > maxY) maxY = cy + dy
            if (cz + dz < minZ) minZ = cz + dz
            if (cz + dz > maxZ) maxZ = cz + dz
          }
        }
      }
    }
  }

  return {
    hits: hits,
    yellow: yellow,
    blue: blue,
    violet: violet,
    pink: pink,
    minX: minX,
    maxX: maxX,
    minY: minY,
    maxY: maxY,
    minZ: minZ,
    maxZ: maxZ
  }
}

function gateInTwilight(level) {
  return String(level.dimension).includes(GATE_TF_DIM)
}

function gateOpen(player, level, cx, cy, cz, consume, src) {
  var now = Date.now()
  var key = String(player.username)
  if (gateCooldown[key] && now - gateCooldown[key] < 2000) return false
  gateCooldown[key] = now

  var s = gateScan(level, cx, cy, cz)

  player.tell('§7[门] ' + src + ' 砖=' + s.hits + ' 黄' + s.yellow + ' 蓝' + s.blue + ' 紫' + s.violet + ' 品红' + s.pink + ' @' + cx + ',' + cy + ',' + cz)

  if (!(s.yellow && s.blue && s.violet && s.pink)) {
    return false
  }

  var x1 = s.minX + 1
  var x2 = s.maxX - 1
  var z1 = s.minZ + 1
  var z2 = s.maxZ - 1
  var y1 = s.minY - 4
  var y2 = s.maxY + 1

  if (x1 > x2 || z1 > z2) {
    player.tell('§e符文砖要围成一圈，中间留空放水。范围 x' + s.minX + '..' + s.maxX + ' z' + s.minZ + '..' + s.maxZ)
    return false
  }

  if (consume) {
    player.server.runCommandSilent(`clear ${player.username} ${GATE_KEY_ITEM} 1`)
  }

  player.server.runCommandSilent(`fill ${x1} ${y1} ${z1} ${x2} ${y2} ${z2} ${GATE_PORTAL} replace minecraft:water`)
  player.server.runCommandSilent(`playsound minecraft:block.end_portal.spawn master ${player.username} ~ ~ ~ 1 1`)
  player.server.runCommandSilent(`particle minecraft:end_rod ${cx} ${cy + 1} ${cz} 0.8 0.8 0.8 0.1 80 normal`)
  player.tell('§5符文砖门已激活：跳进中间的水即可前往。')
  return true
}

function gateGoOverworld(player) {
  var ow = player.server.getLevel(GATE_OVERWORLD)
  if (!ow) {
    player.tell('§c找不到主世界维度')
    return false
  }
  var data = player.persistentData
  var x = data.getDouble('mysterious:home_x')
  var y = data.getDouble('mysterious:home_y')
  var z = data.getDouble('mysterious:home_z')
  if (y <= 0) {
    x = 0.5
    y = 100
    z = 0.5
  }
  player.server.runCommandSilent(`playsound minecraft:block.portal.travel master ${player.username} ~ ~ ~ 1 1`)
  player.teleportToLevel(ow, x, y, z, 0, 0)
  player.server.runCommandSilent(`execute in ${GATE_OVERWORLD} run spreadplayers ${x} ${z} 0 8 under 320 false ${player.username}`)
  data.putBoolean('mysterious:returned', true)
  player.tell('§b你回到了主世界。')
  return true
}

function gateGoTwilight(player) {
  var tf = player.server.getLevel(GATE_TF_DIM)
  if (!tf) {
    player.tell('§c找不到暮色森林维度')
    return false
  }
  player.server.runCommandSilent(`playsound minecraft:block.portal.travel master ${player.username} ~ ~ ~ 1 1`)
  player.teleportToLevel(tf, 0.5, 100, 0.5, 0, 0)
  player.server.runCommandSilent(`execute in ${GATE_TF_DIM} run spreadplayers 0 0 0 64 under 320 false ${player.username}`)
  player.server.runCommandSilent(`execute as ${player.username} at @s run spawnpoint @s ~ ~ ~`)
  player.tell('§5你回到了暮色森林。')
  return true
}

BlockEvents.rightClicked(event => {
  var item = event.item
  if (!item || String(item.id) !== GATE_KEY_ITEM) return

  var player = event.player
  var level = event.level
  var block = event.block

  if (!gateOpen(player, level, Math.floor(block.x), Math.floor(block.y), Math.floor(block.z), true, 'click')) return
  event.cancel()
})

if (typeof ItemEvents !== 'undefined' && typeof ItemEvents.dropped !== 'undefined') {
  ItemEvents.dropped(event => {
    var stack = event.item
    if (stack == null || String(stack.id) !== GATE_KEY_ITEM) return

    var player = event.player
    if (player == null) return

    if (!gateOpen(player, player.level, Math.floor(player.x), Math.floor(player.y), Math.floor(player.z), false, 'drop')) return
    player.server.runCommandSilent(`execute at ${player.username} run kill @e[type=item,nbt={Item:{id:"${GATE_KEY_ITEM}"}},distance=..3,limit=1]`)
  })
}

PlayerEvents.tick(event => {
  var player = event.player
  var level = player.level
  var bx = Math.floor(player.x)
  var by = Math.floor(player.y)
  var bz = Math.floor(player.z)

  if (!gateIsPortal(level, bx, by, bz) && !gateIsPortal(level, bx, by - 1, bz)) {
    gateInside[player.username] = 0
    return
  }

  var ticks = (gateInside[player.username] || 0) + 1
  gateInside[player.username] = ticks
  if (ticks < 20) return

  gateInside[player.username] = 0
  if (gateInTwilight(level)) {
    gateGoOverworld(player)
  } else {
    gateGoTwilight(player)
  }
})
