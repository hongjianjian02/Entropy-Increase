	quest.64D15744454EF749.title: "千古种子"
	quest.66591E711609D902.quest_desc: ["穿过末地传送门，准备挑战末影龙，为深度学习的末影人模型任务开启后续路线。想探索古陵的话，可以从这里直接走 ME 支线。"]
	quest.66591E711609D902.title: "踏入末地"
	quest.1FFF061D8DF8CC89.title: "星环之路"
	quest.1FFF061D8DF8CC89.quest_desc: ["天枢之星开启了第三章。魔法线通向虚空金属与星辉透镜，末地探索和工业产线可以同时推进。"]
	quest.2DCA9C2DB6F10EA2.title: "星环"
	quest.2DCA9C2DB6F10EA2.quest_desc: ["推进星辉共振透镜、通用机械、末影接口和工业先锋四条路线。取得星环并提交后，完成第三章并解锁后续阶段。"]
	quest.54B3A9C7EE031001.title: "炼金炉的恶魔金属"
	quest.54B3A9C7EE031001.quest_desc: ["在无尽领域开采粗恶魔金属，先加工成恶魔金属碎块，再取得 2 枚狱锻锭。"]
	quest.54B3A9C7EE031002.title: "炫彩境云"
	quest.54B3A9C7EE031002.quest_desc: ["让寒风境云在深池毒素中转化为银青境云，再放入魔凝机加工为炫彩境云。"]
	quest.54B3A9C7EE031003.title: "星辉共振"
	quest.54B3A9C7EE031003.quest_desc: ["将启明工作台升级为共振祭坛，并用共振祭坛制作流明结晶器。下一步用它培育摧灭流明水晶石。"]
	quest.54B3A9C7EE031004.title: "摧灭流明水晶石"
	quest.54B3A9C7EE031004.quest_desc: ["以石头作催化剂，为流明结晶器供给摧灭流明与星能液。等水晶簇长成后取下摧灭流明水晶石。"]
	quest.54B3A9C7EE031005.title: "悖论物质"
	quest.54B3A9C7EE031005.quest_desc: ["用神秘之眼扫描腐化裂隙，完成裂隙关闭研究。将摧灭流明水晶石作为核心，用注魔矩阵制作悖论物质。"]
	quest.54B3A9C7EE031006.title: "从裂隙中取种"
	quest.54B3A9C7EE031006.quest_desc: ["将悖论物质投向腐化裂隙，等裂隙坍塌后收集虚空种子。拿到种子后记得扫描，继续解锁邪术研究。"]
	quest.54B3A9C7EE031007.title: "虚空金属锭"
	quest.54B3A9C7EE031007.quest_desc: ["完成虚空种子研究，在坩埚投入 1 枚虚空种子、10 点金属要素和 5 点腐化要素，得到 1 枚虚空金属锭。"]
	quest.54B3A9C7EE031008.title: "准备星辉共振透镜"
	quest.54B3A9C7EE031008.quest_desc: ["完成恶魔金属与虚空金属路线，取得星辉共振透镜。"]
	quest.54B3A9C7EE031009.title: "解放末地"
	quest.54B3A9C7EE031009.quest_desc: ["击败末影龙并取得原版进度「解放末地」，开启任务书中的末影人数据模型路线。"]
	quest.54B3A9C7EE03100A.title: "末影人数据模型"
	quest.54B3A9C7EE03100A.quest_desc: ["用空白数据模型采集末影人的资料，再把模型装进深度学习装置。击杀末影人为模型积累数据，直到模型能够送进模拟室。"]
	quest.54B3A9C7EE03100B.title: "末地基础预测"
	quest.54B3A9C7EE03100B.quest_desc: ["给模拟室供电，投入训练好的末影人模型和预测矩阵，取出末地基础预测。工业先锋的简陋机器框架会用到它。"]
	quest.54B3A9C7EE03100C.title: "通用机械 · 高级控制电路"
	quest.54B3A9C7EE03100C.quest_desc: ["用冶金灌注机制作灌注合金和基础控制电路，再合成高级控制电路。第三章的通用机械目标是高级（Advanced）设备。"]
	quest.54B3A9C7EE03100D.title: "末影接口 · 生动合金"
	quest.54B3A9C7EE03100D.quest_desc: ["在合金炉里依次制作导电合金和充能合金，再用充能合金、末影珍珠与萤石粉炼出生动合金。"]
	quest.54B3A9C7EE03100E.title: "工业先锋 · 高级框架"
	quest.54B3A9C7EE03100E.quest_desc: ["用乳胶生产塑料，并用屠宰工厂收集粉红黏液。在溶解室做出简单框架，再用它加工高级框架。"]
	quest.6A36DF7F83FCC41F.title: "血魔法炼金炉倍产"
	quest.6A9478B98AECA246.title: "任意能量线缆"
	quest.6AEC9D71CCD30C34.title: "击败幻影骑士"
	quest.6D7A7A6198817159.quest_desc: ["推荐叠点血吃一下食物多样性再进行攻略"]
	quest.6D7A7A6198817159.title: "武神女王"
	quest.6E10CC6301CBD39C.title: "储油罐"
	quest.708C2FDFCDE8DDBB.quest_desc: ["在神秘学的研究中解锁 Applied Thaumaturge 的要素终端，随后用奥术工作台制作。要素终端可用于查看与 ME 网络相连的要素存储。"]
	quest.708C2FDFCDE8DDBB.title: "Applied Thaumaturge：要素终端"
